<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.perfectsense.Sense1">
    <property name="ApiVersion" type="u" access="read"/>
    <property name="Available" type="b" access="read"/>
    <property name="ThermalProfile" type="s" access="readwrite"/>
    <property name="PlatformProfile" type="s" access="read"/>
    <property name="AcOnline" type="b" access="read"/>
    <property name="FanDutyCpu" type="u" access="read"/>
    <property name="FanDutyGpu" type="u" access="read"/>
    <property name="FanTargetCpu" type="u" access="read"/>
    <property name="FanTargetGpu" type="u" access="read"/>
    <property name="FanAuto" type="b" access="read"/>
    <property name="FanRpmCpu" type="i" access="read"/>
    <property name="FanRpmGpu" type="i" access="read"/>
    <property name="TempCpu" type="i" access="read"/>
    <property name="TempGpu" type="i" access="read"/>
    <property name="BatteryLimiter" type="i" access="readwrite"/>
    <property name="BatteryCalibration" type="i" access="readwrite"/>
    <property name="UsbCharging" type="i" access="readwrite"/>
    <property name="LcdOverride" type="i" access="readwrite"/>
    <property name="BacklightTimeout" type="i" access="readwrite"/>
    <property name="BootAnimationSound" type="i" access="readwrite"/>
    <property name="Rgb" type="s" access="read"/>
    <property name="RgbEffect" type="s" access="read"/>
    <property name="Logo" type="s" access="read"/>
    <property name="NvidiaPowerd" type="b" access="readwrite"/>
    <property name="CpuGovernor" type="s" access="read"/>
    <property name="CpuEpp" type="s" access="read"/>
    <property name="CpuTurbo" type="b" access="read"/>
    <property name="CpuMaxPerfPct" type="u" access="read"/>
    <property name="CpuPl1Uw" type="t" access="read"/>
    <property name="CpuPl2Uw" type="t" access="read"/>
    <property name="FanAggressorEnabled" type="b" access="readwrite"/>
    <property name="FanAggressorActive" type="b" access="read"/>
    <method name="SetFanTarget">
      <arg direction="in" type="u" name="cpu"/>
      <arg direction="in" type="u" name="gpu"/>
    </method>
    <method name="SetFanAuto"/>
    <method name="SetRgb">
      <arg direction="in" type="s" name="per_zone_csv"/>
    </method>
    <method name="SetRgbEffect">
      <arg direction="in" type="s" name="effect_csv"/>
    </method>
    <method name="SetLogo">
      <arg direction="in" type="s" name="color_csv"/>
    </method>
    <method name="LightingReset"/>
    <method name="InjectEvent">
      <arg direction="in" type="s" name="event"/>
    </method>
    <method name="Refresh"/>
    <method name="CpuPreset">
      <arg direction="in" type="s" name="name"/>
      <arg direction="in" type="b" name="sync_platform_profile"/>
    </method>
    <method name="CpuRestore"/>
    <method name="FanAggressorStatus">
      <arg direction="out" type="b" name="enabled"/>
      <arg direction="out" type="b" name="active"/>
      <arg direction="out" type="b" name="paused_manual"/>
      <arg direction="out" type="i" name="temp_cpu"/>
      <arg direction="out" type="i" name="temp_gpu"/>
      <arg direction="out" type="u" name="native_cpu"/>
      <arg direction="out" type="u" name="native_gpu"/>
      <arg direction="out" type="u" name="applied_cpu"/>
      <arg direction="out" type="u" name="applied_gpu"/>
    </method>
    <method name="FanAggressorReload"/>
    <signal name="ProfileChanged">
      <arg type="s" name="profile"/>
    </signal>
    <signal name="FanAggressorChanged">
      <arg type="b" name="enabled"/>
    </signal>
    <signal name="Hotkey">
      <arg type="s" name="event"/>
      <arg type="u" name="key"/>
    </signal>
  </interface>
</node>
