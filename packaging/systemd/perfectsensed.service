[Unit]
Description=PerfectSense hardware daemon (hotkeys, AC policy, FanAggressor)
Documentation=man:perfectsensed(8)
Documentation=https://github.com/yPerfectBR/PerfectSense
After=systemd-udevd.service
# Soft dependency: start when the module sysfs appears; fail cleanly otherwise.
# Pair with perfectsensed.path so late module load still starts the daemon.
ConditionPathExists=/sys/devices/platform/perfectsense/perfect_sense/api_version

[Service]
Type=notify
ExecStart=/usr/bin/perfectsensed
Restart=on-failure
RestartSec=2
User=root

# Hardening — do NOT set ProtectKernelTunables (sysfs / RAPL / cpufreq writes).
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
PrivateTmp=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelModules=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ReadWritePaths=/run/perfectsense /etc/perfectsense
RuntimeDirectory=perfectsense
RuntimeDirectoryMode=0755
ConfigurationDirectory=perfectsense

[Install]
WantedBy=multi-user.target
Also=perfectsensed.path
